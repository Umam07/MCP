# Local Code Bridge — milestone (a)
# Copy to .env and adjust. Never commit .env.

# Single allowed root. During dev use the dummy repo.
ALLOWED_ROOT=D:\Project Vibe Code\MCP\sandbox-repo
# Public URL advertised in OAuth discovery (your Cloudflare Tunnel URL + no trailing slash).
# Example: PUBLIC_URL=https://curious-otter-1234.trycloudflare.com
PUBLIC_URL=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1

# MODE=read|edit|exec (default edit). Exec tools only load in exec mode.
MODE=edit

# Optional: set passphrase here. If empty, a random >=16 char one is generated on first run.
PASSPHRASE=
# Comma-separated allowed redirect_uri prefixes/patterns (regex strings).
# Keep configurable; rejected URIs are logged.
REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/.*,https://.*\\.chatgpt.com/connector/oauth/.*,https://oauth-redirect.googleapis.com/.*,https://oauth-redirect.googleusercontent.com/.*,https://grok.com/connectors-oauth-exchange-code/.*
# Named scripts for run_script (MODE=exec only). JSON: name -> fixed argv.
# No user args are ever appended; shells and interpreter one-liners are rejected.
SCRIPTS_JSON={"check":["npm","run","check"],"test":["npm","test","--silent"]}
